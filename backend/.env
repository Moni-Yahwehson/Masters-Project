# Anima — runtime configuration.
#
# This file contains NO secrets. Every model runs locally, so there is nothing
# to keep out of version control — it is committed deliberately so the exact
# model configuration used for the results is reproducible.

# ==========================================================================
# MODELS IN USE
# ==========================================================================
# One small multimodal model serves both roles. That matters more than raw
# model quality on consumer hardware: Ollama holds one model in memory at a
# time, so a vision/text split makes it evict and reload gigabytes between
# agents — minutes of disk I/O on every diagnosis.
#
#   gemma3:4b   ~3.3 GB   multimodal (vision + text), large context window
#
LSD_VISION_MODEL=gemma3:4b
LSD_TEXT_MODEL=gemma3:4b

# --- Alternatives (sizes verified against the Ollama registry) -------------
# The vision role needs a MULTIMODAL model. Text-only models (llama3.2,
# qwen2.5, gemma3:1b) cannot fill it — they will fail on every image.
#
# Multimodal, usable for BOTH roles:
#   llava-phi3      2.9 GB   3.8B — smaller than the default, shorter context
#   gemma3:4b       3.3 GB   the default
#   llava:7b        4.7 GB   older; weaker at following the JSON schema
#   qwen2.5vl:7b    6.0 GB   best vision quality here, needs ~8 GB RAM
#
# Leaner still — accepts a split and the model swapping that comes with it,
# only worth it if 3.3 GB genuinely will not fit:
#   LSD_VISION_MODEL=moondream        1.7 GB  1.8B, the smallest usable VLM
#   LSD_TEXT_MODEL=llama3.2:3b        2.0 GB
#
# Otherwise keep both variables on the SAME model: Ollama holds one model in
# memory at a time, so a split makes it reload weights between agents.
# After changing these, run: make models

# ==========================================================================
# LOCAL INFERENCE RUNTIME
# ==========================================================================
# Ollama listens here by default. Point this at any server speaking the same
# /api/chat shape to swap the runtime without changing code.
LSD_LLM_BASE_URL=http://127.0.0.1:11434

# Keep weights resident between agents. The pipeline makes four sequential
# calls; without this Ollama unloads after ~5 minutes idle and each agent pays
# the model load cost again.
LSD_LLM_KEEP_ALIVE=30m

# Cap on generated tokens per agent. Lower = faster; too low truncates the
# synthesis report.
LSD_LLM_MAX_TOKENS=1536

# Context window. Must fit the synthesis prompt (retrieved passages + CNN
# output + visual findings + JSON schema). Raising it costs memory.
LSD_LLM_CONTEXT_TOKENS=8192

# These agents extract and reason rather than write creatively, and small
# local models drift badly when sampled hot.
LSD_LLM_TEMPERATURE=0.1

# Read timeout in seconds. Vision inference on CPU is slow — raise this on a
# machine without a GPU rather than letting agents fail mid-pipeline.
LSD_LLM_TIMEOUT=300

# ==========================================================================
# TRAINED CNN
# ==========================================================================
# Defaults to "<repo>/vision/cattle_lsd_detector.keras".
# LSD_MODEL_PATH=/absolute/path/to/cattle_lsd_detector.keras
LSD_MODEL_IMAGE_SIZE=224
LSD_DECISION_THRESHOLD=0.5
# Probabilities within this band of the threshold are reported as inconclusive.
LSD_UNCERTAINTY_BAND=0.15

# ==========================================================================
# RETRIEVAL (local TF-IDF — no embedding service)
# ==========================================================================
LSD_RETRIEVAL_TOP_K=6
LSD_RETRIEVAL_MIN_SCORE=0.03

# ==========================================================================
# SERVICE
# ==========================================================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LSD_MAX_IMAGES=6
LSD_MAX_IMAGE_BYTES=8388608
LSD_SESSION_TTL=43200

# Set to 0 to run the pipeline in CNN + retrieval-only mode (no LLM at all).
LSD_ENABLE_LLM=1
