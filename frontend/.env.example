# Copy to frontend/.env.local for local overrides.

# Leave empty in development: Vite proxies /api to the backend (vite.config.js).
# In production, set the deployed API origin, e.g. https://api.example.com
VITE_API_BASE_URL=

# Where the dev proxy forwards /api. Change if the backend is not on port 8000.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
